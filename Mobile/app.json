{
  "expo": {
    "name": "Wrap N Track",
    "slug": "wrapntrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/Images/Logo/pensee-logo-square.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wrap N Track to scan product barcode and QR labels."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/Images/Logo/pensee-logo-square.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wrapntrack.mobile"
    },
    "android": {
      "package": "com.wrapntrack.mobile",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/Images/Logo/pensee-logo-square.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./src/Images/Logo/pensee-logo-square.png"
    },
    "extra": {
      "eas": {
        "projectId": "0ae6d83d-ba48-4f8b-a6b2-9c16e226076e"
      }
    },
    "owner": "khenbolima"
  }
}
